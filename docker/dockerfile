FROM nvidia/cuda:11.3.1-cudnn8-devel-ubuntu20.04

ENV DEBIAN_FRONTEND=noninteractive

RUN sed -i \
    -e 's|http://archive.ubuntu.com/ubuntu/|http://mirrors.aliyun.com/ubuntu/|g' \
    -e 's|http://security.ubuntu.com/ubuntu/|http://mirrors.aliyun.com/ubuntu/|g' \
    /etc/apt/sources.list

ENV TZ=Asia/Shanghai

# CUDA + build env
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}
ENV MAX_JOBS=12

# For MinkowskiEngine (distutils)
ENV SETUPTOOLS_USE_DISTUTILS=stdlib

# 1) Base apt packages
RUN apt-get \
    -o Acquire::Retries=5 \
    -o Acquire::http::Proxy=false \
    -o Acquire::https::Proxy=false \
    update && \
    apt-get \
    -o Acquire::Retries=5 \
    -o Acquire::http::Proxy=false \
    -o Acquire::https::Proxy=false \
    install -y --no-install-recommends \
    sudo apt-utils curl wget vim git \
    build-essential cmake make pkg-config ninja-build \
    unzip zip htop tree net-tools iputils-ping \
    python3-pip python-is-python3 python3-dev python3-distutils \
    golang-go \
    libopenblas-dev \
    libpcl-dev \
    pybind11-dev && \
    rm -rf /var/lib/apt/lists/*

# ---- workspace root ----
WORKDIR /workspace


# 3) Pip basic tooling + pinned setuptools
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ENV PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
ENV PIP_DEFAULT_TIMEOUT=120

RUN python3 -m pip install --no-cache-dir --upgrade "pip<25.1" wheel "setuptools==67.6.0" && \
    python3 -m pip install --no-cache-dir -U testresources && \
    python3 -m pip install --no-cache-dir typing-extensions==4.7.1


# 4) Torch (cu113)
RUN HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= \
    python3 -m pip install --no-cache-dir \
    -f https://mirrors.aliyun.com/pytorch-wheels/cu113/ \
    torch==1.11.0+cu113 torchvision==0.12.0+cu113 torchaudio==0.11.0


# 5) OpenMMLab stack
RUN python3 -m pip install --no-cache-dir \
    -f https://download.openmmlab.com/mmcv/dist/cu113/torch1.11.0/index.html \
    mmcv-full==1.7.0 && \
    python3 -m pip install --no-cache-dir \
    mmdet==2.28.0 mmsegmentation==0.30.0 && \
    python3 -m pip install --no-cache-dir \
    matplotlib==3.5.3 Shapely==1.8.5.post1 && \
    python3 -m pip install --no-cache-dir \
    networkx==2.2 scikit-image==0.19.3 && \
    python3 -m pip install --no-cache-dir \
    mmdet3d==1.0.0rc4 && \
    python3 -m pip install --no-cache-dir wandb


# 6) requirements.txt
WORKDIR /workspace
COPY requirements.txt /workspace/requirements.txt
RUN python3 -m pip install --no-cache-dir -r /workspace/requirements.txt


ENV TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6+PTX"


# 7) Clone external deps
RUN git clone https://github.com/open-mmlab/OpenPCDet.git && \
    git clone --recursive https://github.com/NVIDIA/MinkowskiEngine.git


# 8) Install OpenPCDet
WORKDIR /workspace/OpenPCDet
RUN python3 -m pip install --no-cache-dir -r requirements.txt && \
    python3 setup.py develop


# 9) Install MinkowskiEngine
WORKDIR /workspace/MinkowskiEngine
RUN mkdir -p MinkowskiEngineBackend && touch MinkowskiEngineBackend/__init__.py && \
    python3 -c "import distutils; import distutils.msvccompiler; print('distutils stdlib OK')" && \
    python3 -m pip install --no-cache-dir -U pip wheel setuptools && \
    python3 -m pip install --no-cache-dir -v -e .

# 10) Pythonpath
ENV PYTHONPATH=""
ENV PYTHONPATH=/workspace:/workspace/OpenPCDet:/workspace/MinkowskiEngine:${PYTHONPATH}


CMD ["/bin/bash"]

